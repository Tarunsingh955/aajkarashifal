{
 "headers": [
  {
   "source": "/(img-.*|logo.png|favicon-.*|icon-.*|apple-touch-icon.png|og-image.jpg|images/.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=604800, stale-while-revalidate=86400"
    }
   ]
  },
  {
   "source": "/(sw.js|config.json|manifest.json)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=0, must-revalidate"
    }
   ]
  }
 ]
}
